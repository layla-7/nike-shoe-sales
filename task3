      "source": [
        "product_reviews = df.groupby(\"product_name\")[\"reviews\"].sum().sort_values(ascending=False)\n",
        "top = product_reviews.head(6)\n",
        "top[\"Others\"] = product_reviews.iloc[6:].sum()\n",
        "\n",
        "plt.figure(figsize=(10,6))\n",
        "plt.pie(top, labels=top.index, autopct='%1.1f%%', startangle=90)\n",
        "plt.title(\"Reviews by Product\")\n",
        "plt.axis(\"equal\")\n",
        "plt.savefig(\"Reviews by Product.png\")\n",
        "plt.show()"
