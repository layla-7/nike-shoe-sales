        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "df=pd.read_csv(\"/content/nike_shoes_sales.csv\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "plt.figure(figsize=(10,6))\n",
        "plt.hist(df[\"sale_price\"], bins=20, color=\"Green\", alpha=0.7, edgecolor=\"Black\")\n",
        "plt.title(\"Sale Price & Frequency\")\n",
        "plt.xlabel(\"Sale Price\")\n",
        "plt.ylabel(\"Frequency\")\n",
        "plt.grid(axis=\"y\")\n",
        "xmin, xmax = plt.xlim()\n",
        "print(\"The chart currently goes from\", xmin, \"to\", xmax)\n",
        "ymin, ymax = plt.ylim()\n",
        "print(\"The chart currently goes from\", ymin, \"to\", ymax)\n",
        "plt.savefig(\"Sale Price & Frequency Diagram.png\")\n",
        "plt.show()"
      ],
